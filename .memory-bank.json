{
  "skills": {
    "pylance-python-profiling": {
      "name": "pylance-python-profiling",
      "description": "Utilisez ce skill pour profiler du code Python avec Pylance : CPU (Tachyon), trace (sys.monitoring) ou mémoire (Memray). Profilez une exécution complète, une région spécifique entre deux lignes de code, ajoutez des marqueurs de sous-régions, et explorez les profils résultants.",
      "category": "Python / Performance",
      "python_version_requirement": "3.15+ pour le CPU profiling (Tachyon)",
      "tools": {
        "pylancePythonProfiling": {
          "description": "Démarrer/arrêter des captures et inspecter les sessions",
          "actions": [
            "list",
            "status",
            "startCpu",
            "startCpuRegion",
            "stopCpu",
            "startTracing",
            "stopTracing",
            "takeHeapSnapshot",
            "stop",
            "help"
          ]
        },
        "pylancePythonProfileExplorer": {
          "description": "Charger un JSON de métadonnées et interroger le profil",
          "actions": [
            "loadCpuProfile",
            "loadTrace",
            "loadHeapSnapshot",
            "query"
          ]
        }
      },
      "backends": {
        "cpu": "profiling.sampling (Tachyon) - Nécessite Python 3.15+",
        "trace": "sys.monitoring - Fonctionne depuis Python 3.12+",
        "memory": "Memray - Non supporté sous Windows"
      },
      "usage_scenarios": [
        "Profiler une exécution complète (mode launch/attach)",
        "Profiler une région spécifique (startCpuRegion)",
        "Marqueurs de sous-régions (regionMarkers)",
        "Trace avec sys.monitoring",
        "Snapshot Mémoire avec Memray"
      ],
      "explorer_views": {
        "cpu": ["summary", "callTree", "bottomUp", "eventLog", "search", "nodeContext"],
        "trace": ["summary", "events", "byCategory", "byProcessThread", "timelineSlices", "search"],
        "heap": ["summary", "allocations", "search"]
      },
      "limitations": {
        "windows": [
          "Memray non supporté sur Windows",
          "blocking:true non supporté sur Windows",
          "Attach/région sur uv venv peut échouer"
        ],
        "sampling_rate_saturation": "~500 Hz plafond pratique",
        "single_thread_views": "Vues CPU récapitulent un seul thread"
      },
      "file_path": ".skills/pylance-python-profiling.md",
      "added_date": "2026-09-10"
    }
  },
